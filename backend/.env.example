# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=nagarseva_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# FastAPI Configuration
API_TITLE=NagarSeva Backend
API_VERSION=0.1.0
API_DESCRIPTION=Multi-Agent Backend for Civic Issue Management
DEBUG=True
ENVIRONMENT=development

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# NVIDIA NIM Configuration (mock for now)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_VISION=nv-llava-v1.5
NVIDIA_MODEL_TEXT=mistral-7b-instruct

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Geospatial Configuration
DEFAULT_CLUSTERING_RADIUS_METERS=500
ROUTE_BUFFER_RADIUS_METERS=300

# Notification Configuration
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMS_API_KEY=your-sms-api-key

# Escalation Configuration
ESCALATION_CHECK_INTERVAL_HOURS=1
OVERDUE_COMPLAINT_DAYS=7
ESCALATION_LEVELS=ward_supervisor,department_head,commissioner

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
